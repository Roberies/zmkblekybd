#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";
        row-gpios
            = <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>
            ;
        col-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    left_encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* P1.13 */
        b-gpios = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   /* P1.00 */
        resolution = <4>;
        steps = <80>;
        status = "okay";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    /*
     * Matrix labels are "column number + row letter" from the wiring diagram
     * (columns 1-7 = col-gpios 0-6, rows A-F = row-gpios 0-5).
     * Entries are listed in PHYSICAL reading order, so key position N in the
     * keymap is the Nth entry here:
     *   row 1 : 12 keys (0-11)      row 2 : 12 keys (12-23)
     *   row 3 : 10 keys (24-33)     row 4 : 5 keys  (34-38, 36 = encoder button)
     */
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <6>;
        map = <
            RC(1,0) RC(0,0) RC(1,1) RC(0,1) RC(1,2) RC(0,2) RC(0,3) RC(1,3) RC(0,4) RC(1,4) RC(0,5) RC(1,5)
            RC(3,0) RC(2,0) RC(3,1) RC(2,1) RC(3,2) RC(2,2) RC(2,3) RC(3,3) RC(2,4) RC(3,4) RC(2,5) RC(3,5)
            RC(5,0) RC(4,1) RC(5,1) RC(4,2) RC(5,2) RC(5,3) RC(4,3) RC(5,4) RC(4,4) RC(5,5)
            RC(1,6) RC(4,6) RC(5,6) RC(2,6) RC(0,6)
        >;
    };

    /* Approximate flat grid (1u = 100). Only affects the Studio preview. */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                     w   h    x    y  rot   rx   ry
            = <&key_physical_attrs 100 100    0    0   0   0   0  /* 1B */>
            , <&key_physical_attrs 100 100  100    0   0   0   0  /* 1A */>
            , <&key_physical_attrs 100 100  200    0   0   0   0  /* 2B */>
            , <&key_physical_attrs 100 100  300    0   0   0   0  /* 2A */>
            , <&key_physical_attrs 100 100  400    0   0   0   0  /* 3B */>
            , <&key_physical_attrs 100 100  500    0   0   0   0  /* 3A */>
            , <&key_physical_attrs 100 100  700    0   0   0   0  /* 4A */>
            , <&key_physical_attrs 100 100  800    0   0   0   0  /* 4B */>
            , <&key_physical_attrs 100 100  900    0   0   0   0  /* 5A */>
            , <&key_physical_attrs 100 100 1000    0   0   0   0  /* 5B */>
            , <&key_physical_attrs 100 100 1100    0   0   0   0  /* 6A */>
            , <&key_physical_attrs 100 100 1200    0   0   0   0  /* 6B */>
            , <&key_physical_attrs 100 100    0  100   0   0   0  /* 1D */>
            , <&key_physical_attrs 100 100  100  100   0   0   0  /* 1C */>
            , <&key_physical_attrs 100 100  200  100   0   0   0  /* 2D */>
            , <&key_physical_attrs 100 100  300  100   0   0   0  /* 2C */>
            , <&key_physical_attrs 100 100  400  100   0   0   0  /* 3D */>
            , <&key_physical_attrs 100 100  500  100   0   0   0  /* 3C */>
            , <&key_physical_attrs 100 100  700  100   0   0   0  /* 4C */>
            , <&key_physical_attrs 100 100  800  100   0   0   0  /* 4D */>
            , <&key_physical_attrs 100 100  900  100   0   0   0  /* 5C */>
            , <&key_physical_attrs 100 100 1000  100   0   0   0  /* 5D */>
            , <&key_physical_attrs 100 100 1100  100   0   0   0  /* 6C */>
            , <&key_physical_attrs 100 100 1200  100   0   0   0  /* 6D */>
            , <&key_physical_attrs 100 100  100  200   0   0   0  /* 1F */>
            , <&key_physical_attrs 100 100  200  200   0   0   0  /* 2E */>
            , <&key_physical_attrs 100 100  300  200   0   0   0  /* 2F */>
            , <&key_physical_attrs 100 100  400  200   0   0   0  /* 3E */>
            , <&key_physical_attrs 100 100  500  200   0   0   0  /* 3F */>
            , <&key_physical_attrs 100 100  700  200   0   0   0  /* 4F */>
            , <&key_physical_attrs 100 100  800  200   0   0   0  /* 4E */>
            , <&key_physical_attrs 100 100  900  200   0   0   0  /* 5F */>
            , <&key_physical_attrs 100 100 1000  200   0   0   0  /* 5E */>
            , <&key_physical_attrs 100 100 1100  200   0   0   0  /* 6F */>
            , <&key_physical_attrs 100 100  400  300   0   0   0  /* 7B */>
            , <&key_physical_attrs 100 100  500  300   0   0   0  /* 7E */>
            , <&key_physical_attrs 100 100  600  300   0   0   0  /* 7F */>
            , <&key_physical_attrs 100 100  700  300   0   0   0  /* 7C */>
            , <&key_physical_attrs 100 100  800  300   0   0   0  /* 7A */>
            ;
    };
};
